# Dépendances
node_modules/

# Build Next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Données copiées depuis exports/ (dérivées, régénérables) — on garde le dossier
/public/data/*
!/public/data/.gitkeep

# Contenu perso (override local) — NON distribué avec le template.
# Le dépôt committe des content/*.json neutres ; tes vraies valeurs vivent ici.
/content/*.local.json

# Image OpenGraph perso — chaque streamer fournit la sienne (pointée par site.json ogImage)
/public/og.jpg

